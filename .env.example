# StoryForge 环境变量示例
# 复制为 .env 后修改。首次运行无需任何配置（默认 mock）。

# AI 模式：mock（默认，零配置可用）| real（接入真实 API）
VITE_AI_MODE=mock

# 真实 AI 接入所需（仅当 VITE_AI_MODE=real 时生效；缺失项会自动回退 mock）
# 剧情续写（OpenAI 兼容）
VITE_OPENAI_API_KEY=
# 立绘 / 背景生成（Stable Diffusion 兼容 HTTP 接口，返回 { image: base64 } 或 { url }）
VITE_SD_API_URL=
# BGM 生成（Suno / MusicGen）
VITE_SUNO_API_KEY=
